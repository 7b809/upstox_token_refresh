# ================================================================
# Upstox Dashboard - environment configuration
# Copy to .env and fill in your real values.
# ================================================================

# --- TEST FLAG ---------------------------------------------------
# false (default): tokens / profile data are NEVER printed to logs
#                  and are FULLY masked ("********") in the UI.
# true:            tokens / profile data appear in logs and the UI.
TEST_FLAG=false

# --- Upstox credentials -----------------------------------------
UPSTOX_API_KEY=YOUR_API_KEY
UPSTOX_PIN=YOUR_PIN

# --- MongoDB -----------------------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB=UPSTOX_APP_V2
MONGO_COLLECTION=app_tokens

# Label written into the `source` field of the token document.
SOURCE=dashboard

# --- Server ------------------------------------------------------
HOST=127.0.0.1
PORT=8000